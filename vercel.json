{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/w/:world/.well-known/pscale-beach",
      "destination": "/api/pscale-beach?world=:world"
    },
    {
      "source": "/.well-known/pscale-beach",
      "destination": "/api/pscale-beach"
    }
  ],
  "headers": [
    {
      "source": "/button/unlock(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
